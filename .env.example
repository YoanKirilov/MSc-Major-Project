APP_DATA_DIR=
APP_NMAP_PATH=
APP_PORT=8765
APP_AI_PROVIDER=ollama
APP_AI_BASE_URL=http://127.0.0.1:11434
APP_AI_MODEL=llama3.2:3b
APP_AI_TIMEOUT_SECONDS=60
# Optional Pi-hole v6. Use a private IP origin, preferably HTTPS.
APP_PIHOLE_URL=
APP_PIHOLE_PASSWORD=
# Alternative to APP_PIHOLE_PASSWORD; set only one. UTF-8, single-line secret,
# at most 4 KiB, stored outside the repository/OneDrive with restricted permissions.
APP_PIHOLE_PASSWORD_FILE=
